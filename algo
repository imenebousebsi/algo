ALGORITHM SimpleCheck
VAR
    c : CHAR
    len : INTEGER := 0
    words : INTEGER := 1
    vowels : INTEGER := 0

BEGIN
    Read(c)

    WHILE (c <> '.') DO
        len := len + 1

        IF (c = ' ') THEN
            words := words + 1
        END_IF

        IF (c='a' OR c='e' OR c='i' OR c='o' OR c='u') THEN
            vowels := vowels + 1
        END_IF

        Read(c)
    END_WHILE

    // Count the final period '.'
    len := len + 1

    Write(len)
    Write(words)
    Write(vowels)
END